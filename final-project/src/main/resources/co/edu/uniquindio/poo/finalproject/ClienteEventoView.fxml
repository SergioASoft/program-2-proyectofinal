<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" styleClass="main-container" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.finalproject.viewController.ClienteEventoViewController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="login-card">
            <padding><Insets bottom="15" left="25" right="25" top="15" /></padding>
            <children>
                <VBox>
                    <Label styleClass="header-label" text="Explorar Eventos" />
                    <Label styleClass="secondary-label" text="Encuentra los mejores espectáculos para ti" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER" spacing="15">
                    <children>
                        <Button onAction="#verMisCompras" prefHeight="45.0" styleClass="primary-button" text="🎟 MIS ENTRADAS" />
                        <Button onAction="#regresar" prefHeight="45.0" styleClass="link-button" text="Volver al inicio" />
                    </children>
                </HBox>
            </children>
            <BorderPane.margin><Insets bottom="10" left="15" right="15" top="15" /></BorderPane.margin>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="300.0" spacing="15" styleClass="login-card">
            <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
            <children>
                <Label styleClass="section-header-label" text="FILTRAR BÚSQUEDA" />
                <TextField fx:id="txtBusqueda" promptText="🔍 Nombre del evento..." styleClass="text-field" />
                <Separator />
                <Label text="Ciudad" style="-fx-font-weight: bold;" />
                <ComboBox fx:id="comboCiudad" maxWidth="Infinity" promptText="Seleccionar Ciudad" styleClass="text-field" />
                <Label text="Categoría" style="-fx-font-weight: bold;" />
                <ComboBox fx:id="comboCategoria" maxWidth="Infinity" promptText="Tipo de Evento" styleClass="text-field" />
                <Label text="Fecha del Evento" style="-fx-font-weight: bold;" />
                <DatePicker fx:id="dpFecha" maxWidth="Infinity" promptText="¿Cuándo?" styleClass="text-field" />
                <Region VBox.vgrow="ALWAYS" />
                <Button onAction="#limpiarFiltros" maxWidth="Infinity" styleClass="link-button" text="Limpiar Filtros" />
                <Button onAction="#aplicarFiltros" maxWidth="Infinity" prefHeight="45.0" styleClass="primary-button" text="BUSCAR" />
            </children>
            <BorderPane.margin><Insets bottom="15" left="15" right="5" top="5" /></BorderPane.margin>
        </VBox>
    </left>

    <center>
        <VBox spacing="10" styleClass="login-card">
            <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>
            <children>
                <Label fx:id="lblResultados" styleClass="section-header-label" text="EVENTOS DISPONIBLES" />
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                    <content>
                        <FlowPane fx:id="containerCards" hgap="25" vgap="25">
                            <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
                        </FlowPane>
                    </content>
                </ScrollPane>
            </children>
            <BorderPane.margin><Insets bottom="15" left="5" right="15" top="5" /></BorderPane.margin>
        </VBox>
    </center>
</BorderPane>