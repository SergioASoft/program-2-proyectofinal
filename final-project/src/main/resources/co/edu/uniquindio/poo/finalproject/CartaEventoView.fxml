<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" styleClass="login-card" style="-fx-pref-width: 280; -fx-cursor: hand; -fx-border-color: #dfe6e9; -fx-border-radius: 10;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
    <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>
    <children>
        <HBox alignment="TOP_RIGHT">
            <Label fx:id="lblEstado" style="-fx-background-color: #e1f5fe; -fx-text-fill: #0288d1; -fx-padding: 2 8; -fx-background-radius: 5;" text="PUBLICADO" />
        </HBox>

        <VBox spacing="2">
            <Label fx:id="lblNombre" style="-fx-font-weight: bold; -fx-font-size: 16;" text="Nombre del Evento" wrapText="true" />
            <Label fx:id="lblId" style="-fx-text-fill: #b2bec3; -fx-font-size: 11;" text="ID: CON-001" />
        </VBox>

        <Separator />

        <GridPane vgap="5">
            <columnConstraints>
                <ColumnConstraints prefWidth="30" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <children>
                <Label text="📍" GridPane.columnIndex="0" />
                <Label fx:id="lblLugar" text="Ciudad, Recinto" GridPane.columnIndex="1" />

                <Label text="📅" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <Label fx:id="lblFecha" text="23/05/2026 - 20:00" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                <Label text="🏷️" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <Label fx:id="lblCategoria" text="Concierto" GridPane.rowIndex="2" GridPane.columnIndex="1" />
            </children>
        </GridPane>
    </children>
</VBox>
