<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" styleClass="main-container" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.finalproject.viewController.EventoViewController">

    <top>
        <VBox spacing="10" styleClass="login-card">
            <padding><Insets bottom="15" left="25" right="25" top="15" /></padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <children>
                        <VBox>
                            <Label styleClass="header-label" text="Gestión de Eventos" />
                            <Label styleClass="secondary-label" text="Administre el ciclo de vida de los espectáculos" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />

                        <!-- Contenedor de Botones de Creación -->
                        <HBox spacing="10">
                            <children>
                                <!-- Botón Crear Recinto (Estilo secundario/link para diferenciarlo) -->
                                <Button onAction="#crearRecinto" prefHeight="45.0" prefWidth="180.0" styleClass="link-button" style="-fx-border-color: -fx-primary-color; -fx-border-radius: 8;" text="+ NUEVO RECINTO" />

                                <!-- Botón Crear Evento (Acción Principal Destacada) -->
                                <Button onAction="#crearEvento" prefHeight="45.0" prefWidth="200.0" styleClass="primary-button" text="+ NUEVO EVENTO" />
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <Separator styleClass="sidebar-separator" />

                <!-- Barra de Filtros -->
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <children>
                        <TextField fx:id="txtBusqueda" prefWidth="300.0" promptText="🔍 Buscar por nombre o ID..." styleClass="text-field" />
                        <ComboBox fx:id="filterCategoria" prefWidth="150.0" promptText="Categoría" styleClass="text-field" />
                        <ComboBox fx:id="filterEstado" prefWidth="150.0" promptText="Estado" styleClass="text-field" />
                        <DatePicker fx:id="filterFecha" promptText="Filtrar por fecha" styleClass="text-field" />
                        <Button styleClass="link-button" text="Limpiar Filtros" />
                    </children>
                </HBox>
            </children>
            <BorderPane.margin><Insets bottom="10" left="15" right="15" top="15" /></BorderPane.margin>
        </VBox>
    </top>

    <center>
        <VBox styleClass="login-card">
            <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>
            <children>
                <Label styleClass="section-header-label" text="CATÁLOGO DE EVENTOS" />
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                    <content>
                        <!-- Este FlowPane es donde se agregarán las tarjetas dinámicamente -->
                        <FlowPane fx:id="containerCards" hgap="20" vgap="20">
                            <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
                        </FlowPane>
                    </content>
                </ScrollPane>
            </children>
            <BorderPane.margin><Insets bottom="15" left="15" right="5" top="5" /></BorderPane.margin>
        </VBox>
    </center>

    <right>
        <VBox prefWidth="280.0" spacing="15" styleClass="login-card">
            <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
            <children>
                <Label styleClass="section-header-label" text="ACCIONES DE CONTROL" />

                <!-- Acciones de Estado (Agrupadas) -->
                <VBox spacing="10">
                    <Button maxWidth="Infinity" onAction="#actualizarEvento" styleClass="menu-button" style="-fx-text-fill: #2d3436;" text="📝 Editar Detalles" />
                    <Button maxWidth="Infinity" onAction="#publicarEvento" styleClass="menu-button" style="-fx-text-fill: #2ecc71;" text="🚀 Publicar Evento" />
                    <Button maxWidth="Infinity" onAction="#pausarEvento" styleClass="menu-button" style="-fx-text-fill: #f1c40f;" text="⏸ Pausar Venta" />
                    <Button maxWidth="Infinity" onAction="#cancelarEvento" styleClass="menu-button" style="-fx-text-fill: #e67e22;" text="🚫 Cancelar Evento" />
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <Separator />

                <!-- Acción Peligrosa -->
                <Button maxWidth="Infinity" onAction="#eliminarEvento" styleClass="logout-button" text="ELIMINAR PERMANENTE" />
            </children>
            <BorderPane.margin><Insets bottom="15" left="5" right="15" top="5" /></BorderPane.margin>
        </VBox>
    </right>
</BorderPane>
