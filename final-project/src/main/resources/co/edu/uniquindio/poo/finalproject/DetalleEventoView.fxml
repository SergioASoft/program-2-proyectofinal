<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox prefWidth="500.0" spacing="20" style="-fx-background-color: white; -fx-background-radius: 20; -fx-border-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 5);" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.finalproject.viewController.DetalleEventoViewController">
    <padding><Insets bottom="35" left="35" right="35" top="35" /></padding>
    <children>
        <Label fx:id="lblNombre" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #2d3436;" text="Nombre del Evento" wrapText="true" />
        <Separator />
        <GridPane hgap="15" vgap="15">
            <columnConstraints>
                <ColumnConstraints minWidth="100" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <children>
                <Label style="-fx-font-weight: bold; -fx-text-fill: #636e72;" text="📍 Ciudad:" />
                <Label fx:id="lblCiudad" GridPane.columnIndex="1" />
                <Label style="-fx-font-weight: bold; -fx-text-fill: #636e72;" text="🏛️ Lugar:" GridPane.rowIndex="1" />
                <Label fx:id="lblLugar" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label style="-fx-font-weight: bold; -fx-text-fill: #636e72;" text="📅 Fecha:" GridPane.rowIndex="2" />
                <Label fx:id="lblFecha" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label style="-fx-font-weight: bold; -fx-text-fill: #636e72;" text="📝 Descripción:" GridPane.rowIndex="3" />
                <Label fx:id="lblDescripcion" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            </children>
        </GridPane>
        <HBox alignment="CENTER" spacing="20">
            <padding><Insets top="10" /></padding>
            <Button onAction="#regresar" prefHeight="45" prefWidth="120" styleClass="link-button" text="SALIR" />
            <Button onAction="#comprar" prefHeight="45" prefWidth="240" styleClass="primary-button" text="COMPRAR ENTRADAS" />
        </HBox>
    </children>
</VBox>
