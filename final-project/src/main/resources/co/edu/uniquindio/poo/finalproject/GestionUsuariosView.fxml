<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane prefHeight="720.0" prefWidth="1280.0" styleClass="main-container" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.finalproject.viewController.GestionUsuariosViewController">
    <top>
        <VBox spacing="10" styleClass="login-card">
            <padding><Insets bottom="15" left="25" right="25" top="15" /></padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <children>
                        <VBox>
                            <Label styleClass="header-label" text="Gestion de Usuarios" />
                            <Label styleClass="secondary-label" text="Cree, actualice, elimine y consulte usuarios del sistema" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#regresar" prefHeight="45.0" prefWidth="130.0" styleClass="link-button" text="Volver" />
                    </children>
                </HBox>
            </children>
            <BorderPane.margin><Insets bottom="10" left="15" right="15" top="15" /></BorderPane.margin>
        </VBox>
    </top>
    <left>
        <VBox prefWidth="420.0" spacing="15" styleClass="login-card">
            <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
            <children>
                <Label styleClass="section-header-label" text="DATOS DEL USUARIO" />
                <GridPane hgap="10" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" />
                        <ColumnConstraints percentWidth="50" />
                    </columnConstraints>
                    <children>
                        <TextField fx:id="txtId" promptText="ID usuario" GridPane.columnIndex="0" />
                        <ComboBox fx:id="comboTipoUsuario" maxWidth="Infinity" promptText="Tipo" GridPane.columnIndex="1" />
                        <TextField fx:id="txtNombre" promptText="Nombre completo" GridPane.columnSpan="2" GridPane.rowIndex="1" />
                        <TextField fx:id="txtCorreo" promptText="Correo electronico" GridPane.columnSpan="2" GridPane.rowIndex="2" />
                        <TextField fx:id="txtTelefono" promptText="Telefono" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <TextField fx:id="txtContrasena" promptText="Contrasena" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                    </children>
                </GridPane>
                <Button maxWidth="Infinity" onAction="#guardarUsuario" prefHeight="45.0" styleClass="primary-button" text="GUARDAR USUARIO" />
                <Button maxWidth="Infinity" onAction="#limpiarFormulario" prefHeight="40.0" styleClass="link-button" text="Nuevo formulario" />
                <Button maxWidth="Infinity" onAction="#eliminarUsuario" prefHeight="40.0" styleClass="logout-button" text="ELIMINAR SELECCIONADO" />
            </children>
            <BorderPane.margin><Insets bottom="15" left="15" right="10" top="5" /></BorderPane.margin>
        </VBox>
    </left>
    <center>
        <VBox spacing="12" styleClass="login-card">
            <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
            <children>
                <Label styleClass="section-header-label" text="LISTADO DE USUARIOS" />
                <TextField fx:id="txtBusqueda" promptText="Buscar por ID, nombre o correo" />
                <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="130.0" text="ID" />
                        <TableColumn fx:id="colNombre" prefWidth="220.0" text="Nombre" />
                        <TableColumn fx:id="colCorreo" prefWidth="260.0" text="Correo" />
                        <TableColumn fx:id="colTelefono" prefWidth="150.0" text="Telefono" />
                        <TableColumn fx:id="colTipo" prefWidth="120.0" text="Tipo" />
                    </columns>
                </TableView>
            </children>
            <BorderPane.margin><Insets bottom="15" left="5" right="15" top="5" /></BorderPane.margin>
        </VBox>
    </center>
</BorderPane>