<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" styleClass="main-container" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.finalproject.viewController.GestionAsientosViewController">
    <top>
        <VBox spacing="12" styleClass="login-card">
            <padding><Insets bottom="15" left="25" right="25" top="15" /></padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <children>
                        <VBox>
                            <Label styleClass="header-label" text="Gestion de Asientos" />
                            <Label styleClass="secondary-label" text="Disponibilidad, bloqueo, liberacion y consulta por zona" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#regresar" styleClass="link-button" text="Volver" />
                    </children>
                </HBox>
                <HBox spacing="12">
                    <children>
                        <ComboBox fx:id="comboEvento" prefWidth="360.0" promptText="Evento" styleClass="text-field" />
                        <ComboBox fx:id="comboZona" prefWidth="260.0" promptText="Zona" styleClass="text-field" />
                        <Label fx:id="lblOcupacion" styleClass="secondary-label" text="Sin zona seleccionada" />
                    </children>
                </HBox>
            </children>
            <BorderPane.margin><Insets bottom="10" left="15" right="15" top="15" /></BorderPane.margin>
        </VBox>
    </top>

    <center>
        <VBox spacing="12" styleClass="login-card">
            <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>
            <children>
                <Label styleClass="section-header-label" text="ASIENTOS" />
                <TableView fx:id="tablaAsientos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="140.0" text="ID" />
                        <TableColumn fx:id="colFila" prefWidth="90.0" text="Fila" />
                        <TableColumn fx:id="colNumero" prefWidth="100.0" text="Numero" />
                        <TableColumn fx:id="colPrecio" prefWidth="120.0" text="Precio" />
                        <TableColumn fx:id="colEstado" prefWidth="150.0" text="Estado" />
                    </columns>
                </TableView>
            </children>
            <BorderPane.margin><Insets bottom="15" left="15" right="5" top="5" /></BorderPane.margin>
        </VBox>
    </center>

    <right>
        <VBox prefWidth="340.0" spacing="14" styleClass="login-card">
            <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
            <children>
                <Label styleClass="section-header-label" text="DETALLE DEL ASIENTO" />
                <GridPane hgap="10" vgap="10">
                    <children>
                        <TextField fx:id="txtId" promptText="ID asiento" GridPane.columnSpan="2" />
                        <TextField fx:id="txtFila" promptText="Fila" GridPane.rowIndex="1" />
                        <TextField fx:id="txtNumero" promptText="Numero" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <TextField fx:id="txtPrecio" promptText="Precio" GridPane.columnSpan="2" GridPane.rowIndex="2" />
                        <ComboBox fx:id="comboEstado" maxWidth="Infinity" promptText="Estado" GridPane.columnSpan="2" GridPane.rowIndex="3" />
                    </children>
                </GridPane>
                <Button maxWidth="Infinity" onAction="#guardarAsiento" prefHeight="42.0" styleClass="primary-button" text="Guardar" />
                <Button maxWidth="Infinity" onAction="#limpiarFormulario" styleClass="link-button" text="Nuevo formulario" />
                <Separator />
                <Button maxWidth="Infinity" onAction="#liberarAsiento" styleClass="link-button" text="Liberar" />
                <Button maxWidth="Infinity" onAction="#reservarAsiento" styleClass="link-button" text="Reservar" />
                <Button maxWidth="Infinity" onAction="#bloquearAsiento" styleClass="link-button" text="Bloquear" />
                <Button maxWidth="Infinity" onAction="#eliminarAsiento" styleClass="logout-button" text="Eliminar" />
            </children>
            <BorderPane.margin><Insets bottom="15" left="5" right="15" top="5" /></BorderPane.margin>
        </VBox>
    </right>
</BorderPane>
