<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" styleClass="main-container" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.finalproject.viewController.GestionComprasAdminViewController">
    <top>
        <VBox spacing="12" styleClass="login-card">
            <padding><Insets bottom="15" left="25" right="25" top="15" /></padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <children>
                        <VBox>
                            <Label styleClass="header-label" text="Gestion de Compras" />
                            <Label styleClass="secondary-label" text="Consulta, estados, reembolsos, incidencias y reasignacion de asientos" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#regresar" styleClass="link-button" text="Volver" />
                    </children>
                </HBox>
                <HBox spacing="12">
                    <children>
                        <TextField fx:id="txtBusqueda" prefWidth="260.0" promptText="Compra, evento o ID" />
                        <DatePicker fx:id="dpFecha" promptText="Fecha" />
                        <ComboBox fx:id="comboEstado" prefWidth="170.0" promptText="Estado" />
                        <Button onAction="#aplicarFiltros" styleClass="primary-button" text="Filtrar" />
                        <Button onAction="#limpiarFiltros" styleClass="link-button" text="Limpiar" />
                    </children>
                </HBox>
            </children>
            <BorderPane.margin><Insets bottom="10" left="15" right="15" top="15" /></BorderPane.margin>
        </VBox>
    </top>

    <center>
        <VBox spacing="12" styleClass="login-card">
            <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>
            <children>
                <Label styleClass="section-header-label" text="COMPRAS" />
                <TableView fx:id="tablaCompras" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="120.0" text="ID" />
                        <TableColumn fx:id="colCliente" prefWidth="170.0" text="Cliente" />
                        <TableColumn fx:id="colEvento" prefWidth="220.0" text="Evento" />
                        <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado" />
                        <TableColumn fx:id="colTotal" prefWidth="120.0" text="Total" />
                        <TableColumn fx:id="colEntradas" prefWidth="90.0" text="Entradas" />
                    </columns>
                </TableView>
            </children>
            <BorderPane.margin><Insets bottom="15" left="15" right="5" top="5" /></BorderPane.margin>
        </VBox>
    </center>

    <right>
        <VBox prefWidth="340.0" spacing="14" styleClass="login-card">
            <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
            <children>
                <Label styleClass="section-header-label" text="DETALLE Y ACCIONES" />
                <Label fx:id="lblDetalle" text="Sin compra seleccionada" wrapText="true" />
                <Separator />
                <Button maxWidth="Infinity" onAction="#confirmarCompra" styleClass="primary-button" text="Confirmar compra" />
                <Button maxWidth="Infinity" onAction="#cancelarCompra" styleClass="link-button" text="Cancelar creada" />
                <Button maxWidth="Infinity" onAction="#reembolsarCompra" styleClass="link-button" text="Registrar reembolso" />
                <Button maxWidth="Infinity" onAction="#registrarIncidencia" styleClass="link-button" text="Registrar incidencia" />
                <Separator />
                <Label styleClass="section-header-label" text="REASIGNAR ASIENTOS" />
                <ComboBox fx:id="comboZona" maxWidth="Infinity" promptText="Zona" />
                <ListView fx:id="listaAsientos" prefHeight="190.0" />
                <Button maxWidth="Infinity" onAction="#reasignarAsientos" styleClass="primary-button" text="Reasignar seleccion" />
            </children>
            <BorderPane.margin><Insets bottom="15" left="5" right="15" top="5" /></BorderPane.margin>
        </VBox>
    </right>
</BorderPane>
