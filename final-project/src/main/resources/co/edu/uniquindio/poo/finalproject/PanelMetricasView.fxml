<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" styleClass="main-container" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.finalproject.viewController.PanelMetricasViewController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="login-card">
            <padding><Insets bottom="15" left="25" right="25" top="15" /></padding>
            <children>
                <VBox>
                    <Label styleClass="header-label" text="Panel de Metricas" />
                    <Label styleClass="secondary-label" text="Ventas, ocupacion, servicios, cancelacion y top eventos" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="comboReporte" prefWidth="230.0" promptText="Reporte" />
                <Button onAction="#exportarCsv" styleClass="primary-button" text="CSV" />
                <Button onAction="#exportarPdf" styleClass="primary-button" text="PDF" />
                <Button onAction="#refrescar" styleClass="link-button" text="Refrescar" />
                <Button onAction="#regresar" styleClass="link-button" text="Volver" />
            </children>
            <BorderPane.margin><Insets bottom="10" left="15" right="15" top="15" /></BorderPane.margin>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <GridPane hgap="15" vgap="15">
                    <padding><Insets bottom="15" left="15" right="15" top="5" /></padding>
                    <children>
                        <VBox spacing="8" styleClass="login-card">
                            <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>
                            <children>
                                <Label styleClass="section-header-label" text="VENTAS POR PERIODO" />
                                <LineChart fx:id="chartVentas" prefHeight="260.0">
                                    <xAxis><CategoryAxis label="Fecha" /></xAxis>
                                    <yAxis><NumberAxis label="Ingresos" /></yAxis>
                                </LineChart>
                            </children>
                        </VBox>
                        <VBox spacing="8" styleClass="login-card" GridPane.columnIndex="1">
                            <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>
                            <children>
                                <Label styleClass="section-header-label" text="OCUPACION POR ZONA" />
                                <BarChart fx:id="chartOcupacion" prefHeight="260.0">
                                    <xAxis><CategoryAxis label="Zona" /></xAxis>
                                    <yAxis><NumberAxis label="Porcentaje" /></yAxis>
                                </BarChart>
                            </children>
                        </VBox>
                        <VBox spacing="8" styleClass="login-card" GridPane.rowIndex="1">
                            <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>
                            <children>
                                <Label styleClass="section-header-label" text="INGRESOS POR SERVICIOS" />
                                <PieChart fx:id="chartServicios" prefHeight="260.0" />
                            </children>
                        </VBox>
                        <VBox spacing="8" styleClass="login-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>
                            <children>
                                <Label fx:id="lblTasaCancelacion" styleClass="section-header-label" text="TASA DE CANCELACION" />
                                <PieChart fx:id="chartCancelacion" prefHeight="260.0" />
                            </children>
                        </VBox>
                        <VBox spacing="8" styleClass="login-card" GridPane.columnSpan="2" GridPane.rowIndex="2">
                            <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>
                            <children>
                                <Label styleClass="section-header-label" text="TOP EVENTOS" />
                                <BarChart fx:id="chartTopEventos" prefHeight="260.0">
                                    <xAxis><CategoryAxis label="Evento" /></xAxis>
                                    <yAxis><NumberAxis label="Compras" /></yAxis>
                                </BarChart>
                            </children>
                        </VBox>
                    </children>
                </GridPane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
